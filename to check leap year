#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Keypad.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const byte ROWS = 4; 
const byte COLS = 4; 

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {5, 4, 3, 2}; 
byte colPins[COLS] = {9, 8, 7, 6}; 

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

String inputYear = "";

void setup() {
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0,0);
  lcd.print("Enter Year:");
}

void loop() {
  char key = keypad.getKey();

  if (key) {
    if (key >= '0' && key <= '9') {
      if (inputYear.length() < 4) {
        inputYear += key;
        lcd.setCursor(inputYear.length() - 1, 1);
        lcd.print(key);
      }
    } else if (key == '#') { // Submit
      if (inputYear.length() == 4) {
        int year = inputYear.toInt();
        lcd.clear();
        lcd.setCursor(0,0);
        lcd.print("Year: " + inputYear);
        lcd.setCursor(0,1);
        if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
          lcd.print("Leap Year!");
        } else {
          lcd.print("Not a Leap Year");
        }
        delay(3000);
        lcd.clear();
        lcd.setCursor(0,0);
        lcd.print("Enter Year:");
        inputYear = "";
      }
    } else if (key == '*') { // Clear
      inputYear = "";
      lcd.clear();
      lcd.setCursor(0,0);
      lcd.print("Enter Year:");
    }
  }
}
